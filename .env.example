# Backend/local PostgreSQL reference only. Never put real credentials here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uniguide
# Loaded from backend/.env; existing process environment takes precedence.
# NestJS defaults to 3001 when PORT is absent.
# Do not copy this PORT into frontend/.env.local (the frontend uses 3000).
PORT=3001

# Replace with a random secret of at least 32 bytes in ignored backend/.env.
JWT_ACCESS_SECRET=change-me-in-local-env
JWT_ACCESS_EXPIRES_IN=15m
